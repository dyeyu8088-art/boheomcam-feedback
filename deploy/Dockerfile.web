# 前端静态镜像（client-game 与 admin-web 共用；APP 构建参数区分）
FROM mirror.gcr.io/library/node:22-alpine AS build
# 可选：npm 镜像源（国内主机可传 https://registry.npmmirror.com）
ARG NPM_REGISTRY=https://registry.npmjs.org
ENV npm_config_registry=${NPM_REGISTRY} COREPACK_NPM_REGISTRY=${NPM_REGISTRY}
RUN corepack enable && corepack prepare pnpm@10 --activate
WORKDIR /app
COPY pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages ./packages
COPY apps ./apps
RUN pnpm install --frozen-lockfile=false
ARG APP=client-game
# 站点挂载前缀（admin-web 经网关挂在 /admin/ 下）
ARG BASE=/
ENV VITE_BASE=${BASE}
RUN pnpm --filter @yanbian/${APP} build

FROM mirror.gcr.io/library/nginx:1.27-alpine
ARG APP=client-game
COPY --from=build /app/apps/${APP}/dist /usr/share/nginx/html
COPY deploy/nginx/spa.conf /etc/nginx/conf.d/default.conf
