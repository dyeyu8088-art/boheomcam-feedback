# 复制为 .env 并填写真实值。禁止将 .env 提交到 Git。
NODE_ENV=production
DATABASE_URL=postgres://yanbian:CHANGE_ME@postgres:5432/yanbian
PG_USER=yanbian
PG_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS
INTERNAL_TOKEN=CHANGE_ME_64_RANDOM_CHARS
ADMIN_INIT_PASSWORD=CHANGE_ME_STRONG
API_PORT=8080
GAME_PORT=8090
LOG_LEVEL=info
# 内测编排（docker-compose.test.yml）可选：HTTP_PORT=80；国内主机构建慢可设 NPM_REGISTRY=https://registry.npmmirror.com
